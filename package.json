{
  "name": "mei-portfolio-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "generate": "node scripts/generate-content.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "dev": "node scripts/generate-content.mjs && next dev --webpack",
    "build": "node scripts/generate-content.mjs && next build",
    "start": "next start",
    "check": "node scripts/generate-content.mjs && biome check . && node scripts/check-no-function-declarations.mjs",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@keystatic/core": "^0.6.8",
    "@keystatic/next": "^5.0.5",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "yaml": "^2.9.0"
  }
}
